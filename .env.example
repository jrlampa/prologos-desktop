# ==============================================================================
# Environment Variables for Prologos Application
# ==============================================================================

# ------------------------------------------------------------------------------
# Global / Shared Variables
# ------------------------------------------------------------------------------

# Groq API Key for LLM integrations
# Used by: backend/main.py, scripts/test_groq_integration.py
# Default: (none) - REQUIRED for Groq features
GROQ_API_KEY=

# DataJud API Key for legal data ingestion
# Used by: backend/ingestor_datajud.py
# Default: (none) - REQUIRED for DataJud features
DATAJUD_API_KEY=

# ------------------------------------------------------------------------------
# Frontend (.env.development / Vite)
# ------------------------------------------------------------------------------

# Target URL for the API proxy during frontend development.
# Used by: frontend/vite.config.js
# Default: http://127.0.0.1:8000 (points to the FastAPI backend directly)
# When running with 'server' (Node.js Express proxy), change to http://127.0.0.1:3000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Backend (Python FastAPI)
# ------------------------------------------------------------------------------

# Log level for the backend application (e.g., DEBUG, INFO, WARNING, ERROR)
# Used by: backend/main.py
# Default: INFO
LOG_LEVEL=INFO

# Redis URL for the RQ job queue
# Used by: backend/queue.py
# Default: redis://localhost:6379/0 (when running locally)
# When running with docker-compose, this is typically 'redis://redis:6379/0'
REDIS_URL=redis://localhost:6379/0

# Name of the RQ job queue
# Used by: backend/queue.py
# Default: prologos
PROLOGOS_QUEUE_NAME=prologos

# Database URL for SQLAlchemy (SQLite, PostgreSQL, etc.)
# Used by: backend/database_models.py
# Default: sqlite:///C:/myworld/prologos-desktop/backend/prologos_mvp.db (relative to project root)
# When running with docker-compose, this is typically 'sqlite:////data/prologos_mvp.db'
DATABASE_URL=sqlite:///./backend/prologos_mvp.db

# Automatically create database tables on startup if they don't exist
# Used by: backend/main.py
# Default: true
AUTO_CREATE_DB=true

# Enable/disable database write operations from the Python backend
# Used by: backend/main.py
# Default: true (set to 'false' if using Node.js Express as a single-writer)
PYTHON_DB_WRITES_ENABLED=true

# Maximum allowed size for PDF uploads in bytes
# Used by: backend/main.py
# Default: 10 * 1024 * 1024 (10 MB)
PDF_MAX_SIZE_BYTES=10485760

# Timeout for cloning jobs in seconds
# Used by: backend/main.py
# Default: 600 (10 minutes)
CLONE_JOB_TIMEOUT_SECONDS=600

# TTL for job results in Redis in seconds
# Used by: backend/main.py
# Default: 3600 (1 hour)
CLONE_JOB_RESULT_TTL_SECONDS=3600

# TTL for failed job results in Redis in seconds
# Used by: backend/main.py
# Default: 86400 (24 hours)
CLONE_JOB_FAILURE_TTL_SECONDS=86400

# DataJud API request timeout in seconds
# Used by: backend/ingestor_datajud.py
# Default: 20
DATAJUD_TIMEOUT_SECONDS=20

# Minimum interval between DataJud API calls in seconds (for throttling)
# Used by: backend/ingestor_datajud.py
# Default: 0.35
DATAJUD_MIN_INTERVAL_SECONDS=0.35

# Maximum number of retries for DataJud API calls
# Used by: backend/ingestor_datajud.py
# Default: 5
DATAJUD_MAX_RETRIES=5

# Backoff factor for DataJud API retries
# Used by: backend/ingestor_datajud.py
# Default: 0.7
DATAJUD_BACKOFF_FACTOR=0.7

# TTL for DataJud API cache entries in seconds
# Used by: backend/ingestor_datajud.py
# Default: 604800 (7 days)
DATAJUD_CACHE_TTL_SECONDS=604800

# Path to the DataJud API cache SQLite database
# Used by: backend/ingestor_datajud.py
# Default: ./backend/datajud_cache.sqlite3
DATAJUD_CACHE_PATH=./backend/datajud_cache.sqlite3

# ------------------------------------------------------------------------------
# ML Service (Python FastAPI)
# ------------------------------------------------------------------------------

# Name of the sentence transformer model to load
# Used by: ml_service/main.py
# Default: all-MiniLM-L6-v2
ML_SERVICE_MODEL_NAME=all-MiniLM-L6-v2

# Device to run the ML model on (e.g., cpu, cuda)
# Used by: ml_service/main.py
# Default: (none) - automatically detects
ML_SERVICE_MODEL_DEVICE=

# Normalize embeddings (true/false)
# Used by: ml_service/main.py
# Default: true
ML_SERVICE_NORMALIZE=true

# Maximum number of candidates for ranking
# Used by: ml_service/main.py
# Default: 2000
ML_SERVICE_MAX_CANDIDATES=2000

# Maximum number of characters to process for text embedding
# Used by: ml_service/main.py
# Default: 12000
ML_SERVICE_MAX_TEXT_CHARS=12000

# ------------------------------------------------------------------------------
# Server (Node.js Express)
# ------------------------------------------------------------------------------

# Port for the Node.js Express server to listen on
# Used by: server/src/cli.js (development), docker-compose.yml (production)
# Default: 3001 (development)
# When running with docker-compose, this is typically '3000'
PORT=3001

# Host for the Node.js Express server to listen on
# Used by: server/src/cli.js
# Default: 0.0.0.0
HOST=0.0.0.0

# URL of the ML service
# Used by: server/Dockerfile (via docker-compose)
# Default: http://ml:8001 (when running with docker-compose)
ML_SERVICE_URL=http://ml:8001

# Base URL of the FastAPI backend
# Used by: server/Dockerfile (via docker-compose)
# Default: http://fastapi:8000 (when running with docker-compose)
FASTAPI_BASE_URL=http://fastapi:8000

# Path to the SQLite database file
# Used by: server/Dockerfile (via docker-compose)
# Default: /data/prologos_mvp.db (when running with docker-compose)
SQLITE_PATH=/data/prologos_mvp.db

# Comma-separated list of allowed origins for CORS (e.g., http://localhost:5173,https://yourdomain.com)
# Used by: server/Dockerfile (via docker-compose)
# Default: (none) - CORS is open in development
CORS_ORIGINS=
